generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ───────────────────────────────────────────

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String?
  passwordHash       String?
  emailVerified      DateTime?
  image              String?
  mustChangePassword Boolean  @default(false)
  themePreference    ThemePreference @default(SYSTEM)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  isClient           Boolean  @default(false)
  accountBalance     Float    @default(0)
  referralCode       String?  @unique

  memberships         WorkspaceMember[]
  assignedTasks       Task[]             @relation("TaskAssignee")
  createdTasks        Task[]             @relation("TaskCreator")
  comments            Comment[]
  timeEntries         TimeEntry[]
  notifications       Notification[]
  createdViews        View[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogsAsTarget   AuditLog[]         @relation("AuditTarget")
  supportTickets      SupportTicket[]
  activeTimers        ActiveTimer[]
  taskReminders       TaskReminder[]
  notes               Note[]
  orders              Order[]        @relation("OrderClient")
  orderMessages       OrderMessage[] @relation("OrderMessageAuthor")
  subscriptions       Subscription[] @relation("SubscriptionClient")
  affiliates          Affiliate[]    @relation("AffiliateUser")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InviteToken {
  id          String   @id @default(uuid())
  token       String   @unique
  email       String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

// ─── SaaS Admin Users ───────────────────────────────────────

model AdminUser {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  passwordHash       String
  role               AdminRole @default(ADMIN)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs AuditLog[] @relation("AuditAdminUser")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  VIEWER
}

// ─── Platform Settings (SaaS-level) ─────────────────────────

model PlatformSettings {
  id                          String  @id @default("platform")
  siteName                    String  @default("Opchestra")
  signupEnabled               Boolean @default(true)
  maintenanceMode             Boolean @default(false)
  maintenanceWhitelistDomains String  @default("")
  disableLogin                Boolean @default(false)
  emailProvider               String  @default("resend")
  emailApiKey                 String?
  emailFromAddress            String  @default("noreply@opchestra.com")
  emailFromName               String  @default("Opchestra")
  r2AccountId                 String?
  r2AccessKeyId               String?
  r2SecretAccessKey            String?
  r2BucketName                String  @default("opchestra")
  r2PublicUrl                 String?
  inboundEmailDomain          String  @default("ticket.opchestra.com")
  resendWebhookKey            String?
  resendWebhookSigningSecret  String?
  maxFreeUsers                Int     @default(3)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @default(now()) @updatedAt
}

// ─── Audit Logging ──────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  adminUserId    String?
  adminUserEmail String?
  targetUserId   String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  adminUser  AdminUser? @relation("AuditAdminUser", fields: [adminUserId], references: [id], onDelete: SetNull)
  targetUser User?      @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminUserId])
}

// ─── Support Tickets ────────────────────────────────────────

model SupportTicket {
  id        String                @id @default(uuid())
  userId    String
  subject   String
  status    SupportTicketStatus   @default(OPEN)
  priority  SupportTicketPriority @default(MEDIUM)
  category  String                @default("OTHER")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([status])
  @@index([userId])
}

model SupportMessage {
  id             String   @id @default(uuid())
  ticketId       String
  content        String
  isAdmin        Boolean  @default(false)
  adminUserEmail String?
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Discount Codes ─────────────────────────────────────────

model DiscountCode {
  id           String        @id @default(uuid())
  code         String        @unique
  description  String?
  type         DiscountType  @default(LIFETIME)
  percentOff   Int
  billingScope DiscountScope @default(BOTH)
  maxUses      Int?
  usedCount    Int           @default(0)
  isActive     Boolean       @default(true)
  startsAt     DateTime      @default(now())
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum DiscountType {
  LIFETIME
  FIRST_YEAR
}

enum DiscountScope {
  BOTH
  MONTHLY
  ANNUAL
}

// ─── CRM ────────────────────────────────────────────────────

model Company {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  domain          String?
  industry        String?
  companySize     String?
  annualRevenue   Float?
  hourlyRate      Float?
  clientSince     DateTime?
  billingAddress  String?
  billingAddress2 String?
  billingCity     String?
  billingState    String?
  billingZip      String?
  billingCountry  String    @default("USA")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pipelineStageId String?

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts         Contact[]
  ticketsByCompany Task[]         @relation("TicketCompany")
  invoices         Invoice[]
  pipelineStage    PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  activities       Activity[]     @relation("CompanyActivities")

  @@index([workspaceId])
  @@index([pipelineStageId])
}

model Contact {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  title       String?
  companyId   String?
  role        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipelineStageId String?

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  tickets       Task[]         @relation("TicketContact")
  invoices      Invoice[]
  activities    Activity[]     @relation("ContactActivities")

  @@index([workspaceId])
  @@index([companyId])
  @@index([pipelineStageId])
}

// ─── Notes ──────────────────────────────────────────────────

model Note {
  id          String   @id @default(uuid())
  workspaceId String
  entityType  String
  entityId    String
  content     String
  category    String   @default("general")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([entityType, entityId])
  @@index([workspaceId])
}

// ─── Pipelines ─────────────────────────────────────────────

model Pipeline {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  type        PipelineType
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@index([workspaceId])
}

enum PipelineType {
  SALES
  PRODUCTION
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  color       String   @default("#6366f1")
  position    Int      @default(0)
  automations Json?
  createdAt   DateTime @default(now())

  pipeline  Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  companies Company[]

  @@index([pipelineId])
}

// ─── Activities ─────────────────────────────────────────────

model Activity {
  id          String       @id @default(uuid())
  workspaceId String
  contactId   String?
  companyId   String?
  type        ActivityType
  title       String
  notes       String?
  dueDate     DateTime?
  assigneeId  String?
  completed   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation("ContactActivities", fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?  @relation("CompanyActivities", fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([contactId])
  @@index([companyId])
  @@index([dueDate, completed])
}

enum ActivityType {
  CALL
  NOTE
  EMAIL
  MEETING
  FOLLOW_UP
  CUSTOM
}

// ─── Workspaces ─────────────────────────────────────────────

model Workspace {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  inboundEmailKey     String?  @unique
  staleThresholdDays  Int      @default(14)
  ticketPrefix        String   @default("TKT")
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripePlanId        String?
  subscriptionStatus  String?
  currentPeriodEnd    DateTime?
  stripeConnectId     String?
  seatLimit              Int      @default(3)
  invoicePaymentDueDays  Int      @default(30)
  invoiceDefaultTaxRate  Float    @default(0)
  taskDetailDefaultTab   String   @default("timelog")
  timeLogCategories      Json     @default("[]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  members              WorkspaceMember[]
  projects             Project[]
  taskGroups           TaskGroup[]
  tasks                Task[]
  labels               Label[]
  statusWorkflows      StatusWorkflow[]
  views                View[]
  notifications        Notification[]
  inviteTokens         InviteToken[]
  files                File[]
  customFieldDefinitions CustomFieldDefinition[]
  companies            Company[]
  contacts             Contact[]
  slaRules             SlaRule[]
  invoices             Invoice[]
  activeTimers         ActiveTimer[]
  taskReminders        TaskReminder[]
  notes                Note[]

  settings           WorkspaceSettings?
  portalSettings     PortalSettings?
  services           Service[]
  serviceCategories  ServiceCategory[]
  formTemplates      FormTemplate[]
  orders             Order[]
  subscriptions      Subscription[]
  pipelines          Pipeline[]
  activities         Activity[]
  referralProgram    ReferralProgram?
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  portalPages        PortalPage[]
  emailTemplates     EmailTemplate[]
}

model WorkspaceSettings {
  id          String @id @default(uuid())
  workspaceId String @unique

  emailProvider    String?
  emailApiKey      String?
  emailFromAddress String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PortalSettings {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  enabled         Boolean   @default(false)
  customDomain    String?
  logoUrl         String?
  primaryColor    String    @default("#6366f1")
  accentColor     String    @default("#8b5cf6")
  welcomeMessage  String?
  loginPageHtml   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

enum WorkspaceRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MEMBER
  CLIENT
}

// ─── Projects ───────────────────────────────────────────────

model Project {
  id            String        @id @default(uuid())
  workspaceId   String
  name          String
  description   String?
  status        ProjectStatus @default(ACTIVE)
  defaultViewId String?
  position      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks      Task[]
  phases     Phase[]
  orders     Order[]

  @@index([workspaceId])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// ─── Task Groups (cross-project, workspace-level) ───────

model TaskGroup {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#6B7280")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
}

// ─── Phases (per-project grouping) ──────────────────────

model Phase {
  id        String   @id @default(uuid())
  projectId String
  name      String
  color     String   @default("#6B7280")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

// ─── Tasks ──────────────────────────────────────────────────

model Task {
  id             String       @id @default(uuid())
  workspaceId    String
  projectId      String?
  isPrivate      Boolean   @default(false)
  reminders      TaskReminder[]
  parentTaskId   String?
  assigneeId     String?
  createdById    String
  title          String
  description    Json?
  status         String       @default("Todo")
  priority       TaskPriority @default(NONE)
  startDate      DateTime?
  endDate        DateTime?
  timeEstimate   Int?
  isMilestone    Boolean      @default(false)
  depth          Int          @default(0)
  position       Float        @default(0)
  completedAt    DateTime?
  lastActivityAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  ticketNumber      String?
  source            String?
  contactId         String?
  companyId         String?
  slaResponseDue    DateTime?
  slaResolutionDue  DateTime?
  taskGroupId       String?
  phaseId           String?
  sourceTicketId    String?
  orderId           String?

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceTicket   Task?     @relation("TicketToTask", fields: [sourceTicketId], references: [id], onDelete: SetNull)
  linkedTasks    Task[]    @relation("TicketToTask")
  taskGroup      TaskGroup? @relation(fields: [taskGroupId], references: [id], onDelete: SetNull)
  phase          Phase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentTask     Task?     @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks       Task[]    @relation("SubTasks")
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User      @relation("TaskCreator", fields: [createdById], references: [id])
  contact        Contact?  @relation("TicketContact", fields: [contactId], references: [id], onDelete: SetNull)
  ticketCompany  Company?  @relation("TicketCompany", fields: [companyId], references: [id], onDelete: SetNull)
  order          Order?    @relation("OrderTasks", fields: [orderId], references: [id], onDelete: SetNull)

  comments     Comment[]
  timeEntries  TimeEntry[]
  files        File[]
  taskLabels   TaskLabel[]

  dependsOn         TaskDependency[] @relation("DependentTask")
  dependedOnBy      TaskDependency[] @relation("BlockingTask")
  customFieldValues CustomFieldValue[]
  activeTimers      ActiveTimer[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([workspaceId, status])
  @@index([ticketNumber])
  @@index([taskGroupId])
  @@index([phaseId])
  @@index([orderId])
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Labels ─────────────────────────────────────────────────

model Label {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#6B7280")
  createdAt   DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskLabels TaskLabel[]

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

// ─── Dependencies ───────────────────────────────────────────

model TaskDependency {
  id          String         @id @default(uuid())
  taskId      String
  dependsOnId String
  type        DependencyType @default(FS)
  mode        DependencyMode @default(FLEXIBLE)
  createdAt   DateTime       @default(now())

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum DependencyMode {
  STRICT
  FLEXIBLE
}

// ─── Comments ───────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
}

// ─── Time Entries ───────────────────────────────────────────

model TimeEntry {
  id        String    @id @default(uuid())
  taskId    String
  userId    String
  startTime DateTime?
  endTime   DateTime?
  duration  Int
  date      DateTime
  notes     String?
  category  String?
  billable  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}

// ─── Files ──────────────────────────────────────────────────

model File {
  id           String   @id @default(uuid())
  workspaceId  String
  taskId       String?
  uploadedById String
  name         String
  key          String
  size         Int
  mimeType     String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

// ─── Status Workflows ───────────────────────────────────────

model StatusWorkflow {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  statuses    Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── SLA Rules ──────────────────────────────────────────────

model SlaRule {
  id             String   @id @default(uuid())
  workspaceId    String
  priority       String
  responseTime   Int
  resolutionTime Int
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, priority])
  @@index([workspaceId])
}

// ─── Custom Fields ──────────────────────────────────────────

model CustomFieldDefinition {
  id          String @id @default(uuid())
  workspaceId String
  name        String
  type        String
  config      Json   @default("{}")
  position    Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model CustomFieldValue {
  id                    String @id @default(uuid())
  taskId                String
  customFieldDefinitionId String
  value                 Json

  task       Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([taskId, customFieldDefinitionId])
  @@index([taskId])
}

// ─── Services & Catalog ─────────────────────────────────────

model Service {
  id                String             @id @default(uuid())
  workspaceId       String
  name              String
  description       String?
  descriptionHtml   String?
  price             Float              @default(0)
  currency          String             @default("USD")
  pricingType       PricingType        @default(ONE_TIME)
  recurringInterval RecurringInterval?
  recurringBehavior RecurringBehavior  @default(NO_ACTION)
  trialDays         Int?
  setupFee          Float?
  maxRequests       Int?
  deadline          Int?
  autoAssigneeId    String?
  published         Boolean            @default(false)
  position          Int                @default(0)
  categoryId        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ServiceVariant[]
  addOns         ServiceAddOn[]   @relation("ParentServiceAddOns")
  addOnOf        ServiceAddOn[]   @relation("ChildServiceAddOns")
  taskTemplates  TaskTemplate[]
  formLinks      ServiceForm[]
  orders         Order[]
  subscriptions  Subscription[]

  @@index([workspaceId])
  @@index([categoryId])
}

enum PricingType {
  ONE_TIME
  RECURRING
}

enum RecurringInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringBehavior {
  NO_ACTION
  REOPEN
  NEW_ORDER
  SERVICE_REQUESTS
}

model ServiceVariant {
  id        String @id @default(uuid())
  serviceId String
  name      String
  price     Float
  options   Json   @default("{}")
  position  Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAddOn {
  id              String  @id @default(uuid())
  parentServiceId String
  childServiceId  String
  required        Boolean @default(false)

  parentService Service @relation("ParentServiceAddOns", fields: [parentServiceId], references: [id], onDelete: Cascade)
  childService  Service @relation("ChildServiceAddOns", fields: [childServiceId], references: [id], onDelete: Cascade)

  @@unique([parentServiceId, childServiceId])
}

model ServiceCategory {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services  Service[]

  @@index([workspaceId])
}

model TaskTemplate {
  id               String  @id @default(uuid())
  serviceId        String
  name             String
  description      String?
  position         Int     @default(0)
  assigneeId       String?
  deadlineDays     Int?
  visibleToClient  Boolean @default(false)
  assignedToClient Boolean @default(false)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceForm {
  id        String @id @default(uuid())
  serviceId String
  formId    String
  linkType  String

  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  form    FormTemplate @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([serviceId, formId, linkType])
}

// ─── Forms ──────────────────────────────────────────────────

model FormTemplate {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  type        FormType
  fields      Json      @default("[]")
  rules       Json?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  serviceLinks ServiceForm[]

  @@index([workspaceId])
}

enum FormType {
  ORDER
  INTAKE
  ONBOARDING
  CONTACT
}

model FormSubmission {
  id        String   @id @default(uuid())
  formId    String
  clientId  String?
  orderId   String?
  data      Json     @default("{}")
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form  FormTemplate @relation(fields: [formId], references: [id], onDelete: Cascade)
  order Order?       @relation("OrderSubmissions", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([orderId])
}

// ─── Orders ─────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  workspaceId     String
  clientId        String
  serviceId       String
  invoiceId       String?
  subscriptionId  String?
  status          OrderStatus @default(PENDING)
  dueDate         DateTime?
  priority        Int         @default(0)
  assigneeId      String?
  intakeComplete  Boolean     @default(false)
  variantId       String?
  quantity        Int         @default(1)
  projectId       String?
  totalPrice      Float       @default(0)
  notes           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    User      @relation("OrderClient", fields: [clientId], references: [id])
  service   Service   @relation(fields: [serviceId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  messages        OrderMessage[]
  tasks           Task[]          @relation("OrderTasks")
  formSubmissions FormSubmission[] @relation("OrderSubmissions")

  @@index([workspaceId])
  @@index([clientId])
  @@index([serviceId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  SUBMITTED
  WORKING
  COMPLETE
  CANCELED
}

model OrderMessage {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String
  content   String
  teamOnly  Boolean  @default(false)
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation("OrderMessageAuthor", fields: [authorId], references: [id])

  @@index([orderId])
}

// ─── Subscriptions ──────────────────────────────────────────

model Subscription {
  id                    String             @id @default(uuid())
  workspaceId           String
  clientId              String
  serviceId             String
  stripeSubscriptionId  String?            @unique
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    User      @relation("SubscriptionClient", fields: [clientId], references: [id])
  service   Service   @relation(fields: [serviceId], references: [id])
  orders    Order[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  PENDING_CANCEL
  CANCELED
}

// ─── Plans (SaaS Billing) ───────────────────────────────────

model Plan {
  id                   String  @id @default(uuid())
  name                 String
  description          String?
  priceMonthly         Float
  priceAnnual          Float
  maxUsers             Int
  stripePriceIdMonthly String?
  stripePriceIdAnnual  String?
  features             Json?
  isActive             Boolean @default(true)
  sortOrder            Int     @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─── Invoicing ──────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  workspaceId   String
  invoiceNumber String
  companyId     String?
  contactId     String?
  clientId      String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  paidAt        DateTime?
  sentAt        DateTime?
  paymentUrl    String?
  stripePaymentIntentId String?
  publicKey     String        @unique @default(uuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  orders    Order[]

  @@index([workspaceId])
  @@index([publicKey])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  rate        Float    @default(0)
  amount      Float    @default(0)
  taskId      String?
  projectId   String?
  isSection   Boolean  @default(false)
  isSubItem   Boolean  @default(false)
  isFlat      Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ─── Views ──────────────────────────────────────────────────

model View {
  id          String     @id @default(uuid())
  workspaceId String
  createdById String
  name        String
  layout      ViewLayout @default(TABLE)
  config      Json       @default("{}")
  isShared    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
}

enum ViewLayout {
  TABLE
  LIST
  KANBAN
  CALENDAR
  GANTT
}

// ─── Notifications ──────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  message     String?
  data        Json?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([workspaceId])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENTED
  TASK_MENTIONED
  TASK_DUE_SOON
}

// ─── Task Reminders ─────────────────────────────────────────

model TaskReminder {
  id           String   @id @default(uuid())
  taskId       String
  userId       String
  workspaceId  String
  reminderType String
  triggerAt    DateTime
  sent         Boolean  @default(false)
  createdAt    DateTime @default(now())

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([triggerAt, sent])
  @@index([taskId])
}

// ─── Active Timers ──────────────────────────────────────────

model ActiveTimer {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  workspaceId String
  startedAt   DateTime  @default(now())
  pausedAt    DateTime?
  totalPaused Int       @default(0)
  notes       String?
  category    String?
  billable    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

// ─── Referrals & Affiliates ─────────────────────────────────

model ReferralProgram {
  id                     String   @id @default(uuid())
  workspaceId            String   @unique
  enabled                Boolean  @default(false)
  cookieDays             Int      @default(30)
  autoApproveAffiliates  Boolean  @default(true)
  autoApproveCommissions Boolean  @default(true)
  redirectUrl            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  commissionRules CommissionRule[]
  affiliates      Affiliate[]
}

model CommissionRule {
  id        String         @id @default(uuid())
  programId String
  serviceId String?
  type      CommissionType
  value     Float
  perpetual Boolean        @default(false)
  duration  Int?

  program ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Affiliate {
  id             String   @id @default(uuid())
  programId      String
  clientId       String
  code           String   @unique
  approved       Boolean  @default(true)
  linkedCouponId String?
  createdAt      DateTime @default(now())

  program     ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  client      User            @relation("AffiliateUser", fields: [clientId], references: [id])
  commissions Commission[]
  clicks      AffiliateClick[]

  @@index([programId])
  @@index([clientId])
}

model Commission {
  id          String           @id @default(uuid())
  affiliateId String
  orderId     String
  amount      Float
  status      CommissionStatus @default(UNAPPROVED)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
}

enum CommissionStatus {
  UNAPPROVED
  UNPAID
  PAID
}

model AffiliateClick {
  id          String   @id @default(uuid())
  affiliateId String
  ip          String?
  referrer    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

// ─── API Keys & Webhooks ────────────────────────────────────

model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookEndpoint {
  id           String    @id @default(uuid())
  workspaceId  String
  url          String
  events       String[]
  secret       String
  active       Boolean   @default(true)
  lastCalledAt DateTime?
  lastStatus   Int?
  createdAt    DateTime  @default(now())

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  endpointId  String
  event       String
  payload     Json
  statusCode  Int?
  response    String?
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
}

// ─── Custom Portal Pages ────────────────────────────────────

model PortalPage {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  slug        String
  content     String
  published   Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

// ─── Email Templates ────────────────────────────────────────

model EmailTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  subject     String
  body        String
  variables   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}
